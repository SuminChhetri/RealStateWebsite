# ---------------------------------------------------------------------------
# Supabase
#
# Both strings come from your Supabase project:
#   Project settings → Database → Connection string
#
# DATABASE_URL  Transaction pooler (port 6543). Used by the application.
#               Pooling is what keeps a serverless deployment from exhausting
#               the project's connection limit.
#
# DIRECT_URL    Direct connection (port 5432). Used only by migrations, which
#               need session state that transaction pooling cannot carry.
#
# Replace [PASSWORD] with your database password and [PROJECT-REF] with your
# project reference. Never commit the filled-in file — .env is gitignored.
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Where speaking recordings are written. Local disk by default; swap the
# storage provider in src/lib/providers to use Supabase Storage or S3.
# UPLOAD_DIR=./data/uploads
