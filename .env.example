# ---------------------------------------------------------------------------
# The only value you need.
#
# Supabase → your project → Project settings → Database → Connection string.
# Copy it, replace [YOUR-PASSWORD] with your database password, paste it below.
#
# Migrations, TLS and pooling are all worked out from this one string, so there
# is nothing else to configure.
#
# Never commit the filled-in file — .env is gitignored.
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Any other Postgres works too. A local one needs no password:
# DATABASE_URL=postgresql://postgres@127.0.0.1:5432/meridian

# Where speaking recordings are written. Local disk by default; swap the
# storage provider in src/lib/providers to use Supabase Storage or S3.
# UPLOAD_DIR=./data/uploads
